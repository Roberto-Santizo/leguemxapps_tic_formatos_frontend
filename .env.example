

# URL base de la API real y actual en Laravel (Legumex TIC Formatos). Todo
# lo demás del sistema (login, actas, usuarios, catálogo, historial...) usa
# esta.
VITE_AUTH_API_URL=http://localhost:8000/api

# Opcional. URL base de los archivos públicos de Laravel (firmas de
# Documentos de Entrega, en signatures/...). Si no se define, se calcula
# quitando el "/api" final de VITE_AUTH_API_URL, que es lo que arma Laravel
# por defecto con Storage::disk('public')->url(). Fíjalo aquí solo si el
# backend sirve archivos estáticos desde otro dominio o puerto.
# VITE_STORAGE_URL=http://localhost:8000