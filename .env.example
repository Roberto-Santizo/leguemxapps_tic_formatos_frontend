# URL base del backend viejo (Node/Express) -- todavía usado por actas,
# auditoria, usuarios, PDF y Excel hasta que se migren a Laravel.
VITE_API_URL=http://localhost:3000

# URL base de la nueva API en Laravel (Legumex TIC Formatos). Por ahora solo
# se usa para el login (POST /login).
VITE_AUTH_API_URL=http://192.168.10.209:8000/api

# Opcional. URL base de los archivos públicos de Laravel (firmas de
# Documentos de Entrega, en signatures/...). Si no se define, se calcula
# quitando el "/api" final de VITE_AUTH_API_URL, que es lo que arma Laravel
# por defecto con Storage::disk('public')->url(). Fíjalo aquí solo si el
# backend sirve archivos estáticos desde otro dominio o puerto.
# VITE_STORAGE_URL=http://192.168.10.209:8000